{
  "name": "gulumen-webshop",
  "version": "0.1.2",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prebuild.cjs && prisma generate && next build",
    "start": "node scripts/start.js",
    "postinstall": "prisma generate",
    "deploy:railway": "node scripts/deploy-railway.cjs",
    "lint": "next lint",
    "convert-3d": "node scripts/convert-3d.mjs",
    "convert-3d:batch": "node scripts/convert-3d.mjs --batch",
    "convert-3d:webshop": "node scripts/convert-3d.mjs --webshop",
    "seed:products": "ALLOW_PRODUCT_SEED=1 npx tsx scripts/seed-products.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:unarchive-products": "ALLOW_UNARCHIVE_PRODUCTS=1 npx tsx scripts/unarchive-products.ts",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=github",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@sentry/nextjs": "^8.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.564.0",
    "next": "^14.2.0",
    "next-auth": "^4.24.13",
    "pino": "^9.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.34.5",
    "stripe": "^20.3.1",
    "swr": "^2.4.2",
    "tsx": "^4.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.3.0",
    "@playwright/test": "^1.61.1",
    "@polar3d/model-converter": "^1.1.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.2.0",
    "pino-pretty": "^11.3.0",
    "postcss": "^8.4.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "three": "^0.170.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
