# AI asszisztens: valódi válaszokhoz (OpenAI).
# Ha nincs megadva, a beépített szabályalapú válaszok futnak.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Stripe – kártyás fizetés (Dashboard: https://dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook endpoint: POST https://<domain>/api/stripe/webhook
# 5% kupon (Stripe Dashboard → Coupons): hozz létre 5% off coupont, id-t másold ide
# STRIPE_COUPON_ID_5PERCENT=

# Alkalmazás URL (siker/megszakítás redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hűségkedvezmény küszöb (EUR árfolyam; 50 000 Ft / FX = EUR küszöb)
FX_HUF_PER_EUR=390

# Opcionális: rendelés megerősítő e-mail (Resend)
# RESEND_API_KEY=
# EMAIL_FROM=Gulumen <info@gulumen.hu>

# Admin: sourcing success/fail végpontok (kötelező élesben)
ADMIN_API_KEY=

# Payment webhook hitelesítés (POST /api/payments/webhook – X-Webhook-Secret header)
# A provider / backend ezt a titkot küldi; egyeznie kell.
PAYMENTS_WEBHOOK_SECRET=
