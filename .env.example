# AI asszisztens: valódi válaszokhoz (OpenAI).
# Ha nincs megadva, a beépített szabályalapú válaszok futnak.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Stripe – kártyás fizetés (Dashboard: https://dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook endpoint: POST https://<domain>/api/stripe/webhook
# 5% kupon (Stripe Dashboard → Coupons): hozz létre 5% off coupont, id-t másold ide
# STRIPE_COUPON_ID_5PERCENT=

# Alkalmazás URL (siker/megszakítás redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ÁSZF üzemeltető adatok (láthatók az /aszf oldalon)
# NEXT_PUBLIC_LEGAL_NAME=Gulumen
# NEXT_PUBLIC_LEGAL_ADDRESS=
# NEXT_PUBLIC_LEGAL_EMAIL=info@gulumen.hu
# NEXT_PUBLIC_SUPPORT_PHONE=+36...

# Bunny CDN / Storage (termékfotók – tartós tárolás deploy után is)
# Pull Zone host (pl. gulumen.b-cdn.net) – a storage.bunnycdn.com URL-eket erre cseréli a cleanCdnUrl
NEXT_PUBLIC_BUNNY_CDN_HOST=gulumen.b-cdn.net
# BUNNY_CDN_HOST=gulumen.b-cdn.net
# Storage Zone neve + API kulcs (admin feltöltéshez – Railway Variables!)
# A zone nevet a kliens path-tisztításhoz is látnia kell:
# NEXT_PUBLIC_BUNNY_STORAGE_ZONE=gulumen
# BUNNY_STORAGE_ZONE=gulumen
# BUNNY_STORAGE_API_KEY=
# Opcionális régió előtag (pl. de, ny, la) → de.storage.bunnycdn.com
# BUNNY_STORAGE_REGION=
# Mappa a storage-ben (alapértelmezett: products)
# BUNNY_STORAGE_PATH=products

# PostgreSQL – kötelező a pontrendszerhez, kedvelésekhez és auth-hoz productionben.
# Helyi fejlesztés DB nélkül: auth + like dev fallback, pontok data/dev-gamification.json-ban.
# DATABASE_URL=postgresql://user:pass@localhost:5432/gulumen

# Pont esemény worker (Vercel cron) – /api/cron/process-point-events
# CRON_SECRET=

# Hűségkedvezmény küszöb (EUR árfolyam; 50 000 Ft / FX = EUR küszöb)
FX_HUF_PER_EUR=390

# Opcionális: rendelés megerősítő e-mail (Resend)
# RESEND_API_KEY=re_...
# Feladó (hitelesített domain a Resend-ben, pl. gulumen.com):
EMAIL_FROM=Gulumen <noreply@gulumen.com>
# Opcionális: admin értesítések (callback, gyanús belépés / fiókzárolás)
# ADMIN_EMAIL=ops@gulumen.com

# reCAPTCHA v3 (belépés: /profil és /admin/login). Üresen: captcha kihagyva.
# Google Admin Console → reCAPTCHA v3 kulcspár. Productionben ajánlott.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# Opcionális küszöb (0–1, alap 0.5):
# RECAPTCHA_MIN_SCORE=0.5

# Admin belépés: generálj titkos kulcsot (pl. openssl rand -hex 32)
ADMIN_API_KEY=

# Rejtett admin URL (botok /admin-t keresnek). 8–64 karakter, a–z 0–9 kötőjel.
# Belépés: https://<domain>/<slug>/login   API: /api/<slug>/*
# /admin és /api/admin session nélkül 404. Üresen: a régi /admin marad (dev).
# Generálás: openssl rand -hex 8
# ADMIN_URL_SLUG=desk-a1b2c3d4

# Admin IP whitelist – productionben kötelező (irodai / VPN kimenő IP vagy CIDR, vesszővel).
# Üresen productionben a /admin, /api/admin/* ÉS a rejtett /{ADMIN_URL_SLUG} 403 (lockout).
# Dev-ben üresen nincs szűrés. Szándékos kivétel (ne használd élesben): ADMIN_ALLOWED_IPS=*
# Railway példa (Name=ADMIN_ALLOWED_IPS, Value=):
# ADMIN_ALLOWED_IPS=203.0.113.10,10.8.0.0/24

# Session / JWT (production: kötelező, min. 16 karakter – fail-fast induláskor)
JWT_SECRET=

# NextAuth (Google bejelentkezés). Production: NEXTAUTH_URL = https://<domain>
# NEXTAUTH_SECRET production-ben kötelező (vagy JWT_SECRET alias)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment webhook hitelesítés (POST /api/payments/webhook – X-Webhook-Secret header)
# A provider / backend ezt a titkot küldi; egyeznie kell.
PAYMENTS_WEBHOOK_SECRET=

# Cron védelme (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Upstash Redis – elosztott rate limit + idempotency (Railway multi-instance).
# Ha üres / hiányzik: in-memory rate-limit + idempotency fallback (egy példányon belül).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry – hibajelentés (5xx / unhandled). Üresen hagyva: no-op, nem dob hibát.
# Élesben: SENTRY_DSN (+ opcionálisan NEXT_PUBLIC_SENTRY_DSN a klienshez)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
