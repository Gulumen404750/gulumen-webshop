// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Webshop termékek – adminból kezelhetők. Sourcing deal időzítés itt tárolódik (deploy után nem resetelődik).
model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  /// Belső termékkód / SKU (pl. GUL-0000001454). Adminban szerkeszthető, a webshop frontenden rejtett.
  sku              String?  @unique @db.VarChar(50)
  name             String
  nameEn           String?
  nameDe           String?
  nameRo           String?
  description_hu    String   @default("")
  description_en   String   @default("")
  description_de   String   @default("")
  description_ro   String   @default("")
  /// AI chat tudásbázis / termékspecifikációk (HU) – anyag, tisztítás, méretek, GYIK.
  aiKnowledgeBase  String?  @db.Text
  condition        String   @default("Új")
  category         String
  image            String
  images           String[] @default([])
  images360        String[] @default([])
  /// Színenkénti galéria: ColorVariant[] vagy legacy { [colorId]: string[] }.
  colorImages      Json?
  modelUrl         String?
  priceHuf         Int
  priceEur         Int
  discountPriceHuf Int?
  discountPriceEur Int?
  /// Készlet: -1 = végtelen/készleten; 0 = elfogyott; >0 = darabszám.
  stock            Int      @default(-1)
  variants         Json?    // [{ size?, color? }]
  isNew            Boolean  @default(false)
  onSale           Boolean  @default(false)
  saleStartAt      DateTime?
  saleEndAt        DateTime?
  active           Boolean  @default(true)
  archived         Boolean  @default(false)
  isColorable      Boolean  @default(false)
  likesCount       Int      @default(0)
  /// Termékoldal megtekintések (kattintások) – bot/admin nélkül növelve.
  viewsCount       Int      @default(0)
  // Sourcing / visszaszámlálós: minden időzítés DB-ben, deploy után nem változik
  type             String   @default("stock") // stock | sourcing_deal
  sourcingEnabled  Boolean  @default(false)
  dealStartAt      DateTime?
  dealEndAt        DateTime?
  previewFrom      DateTime?
  maxOrders        Int?
  sourcingStatus   String?  // optional cache: preview | sale | soldout | closed
  /// Sorrend: kisebb = előrébb (pl. beszerzésre rendelhető listán, kategórián belül).
  sortOrder        Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active, archived])
  @@index([category, active])
}

/// Kuponok / kedvezmények – adminból kezelhetők.
model Coupon {
  id           String    @id @default(cuid())
  code         String    @unique
  discountType String    // percent | fixed
  discountValue Int     // percent 0-100 or HUF
  active       Boolean   @default(true)
  validFrom    DateTime?
  validUntil   DateTime?
  minOrderHuf  Int?
  maxUses      Int?     // null = unlimited
  usedCount    Int       @default(0)
  /// Gamification: személyes kupon tulajdonos (egy user = egy aktív gamification kupon)
  userId       String?
  user         User?     @relation("GamificationCoupons", fields: [userId], references: [id], onDelete: SetNull)
  /// gamification | admin | registration | abandoned_cart | birthday
  source       String?
  /// Melyik pontlevonás hozta létre (append-only audit)
  pointTransactionId String? @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
  @@index([userId, active])
  @@index([source])
}

/// Admin / chatbot / webshop beállítások – key-value.
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON or plain string
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  passwordHash String?  // null = OAuth (pl. Google) felhasználó
  name      String?
  /// Marketing / hírlevél hozzájárulás (GDPR). Tranzakciós e-mailektől független.
  marketingOptIn       Boolean   @default(false)
  marketingOptInAt     DateTime?
  marketingOptOutAt    DateTime?
  /// registration | newsletter | checkout | admin | unsubscribe
  marketingOptInSource String?
  /// Checkout welcome 10% hírlevél-kupon egyszer felhasználva (ne lehessen újra).
  hasRedeemedWelcomeCoupon Boolean @default(false)
  /// Opcionális születési dátum (születésnapi 15% kupon).
  birthDate DateTime?
  /// Melyik naptári évben küldtünk már születésnapi kupont (év / Europe/Budapest).
  birthdayCouponLastSentYear Int?
  /// Sikertelen jelszavas belépések a jelenlegi zárolási ablakban.
  failedLoginCount    Int       @default(0)
  /// Aktív fiókzárolás vége (brute-force). null = nincs zár.
  lockedUntil         DateTime?
  lastFailedLoginAt   DateTime?
  lastFailedLoginIp   String?
  /// Utolsó lockout-riasztó e-mail ideje (ne spamelje az admint).
  lockAlertSentAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  productLikes ProductLike[]
  loyaltyRecords LoyaltyRecord[]
  pointWallet UserPointWallet?
  pointTransactions PointTransaction[]
  pointEvents PointEvent[]
  dailyActivities UserDailyActivity[]
  gamificationCoupons Coupon[] @relation("GamificationCoupons")
  promoCoupons        UserPromoCoupon[]
  cartSnapshot        UserCartSnapshot?
  likePointWindow UserLikePointWindow?
  luckySpins LuckySpin[]
}

/// E-mail szintű marketing hozzájárulás (hírlevél, vendég, leiratkozási token).
model MarketingConsent {
  id          String    @id @default(cuid())
  email       String    @unique
  optedIn     Boolean   @default(false)
  confirmed   Boolean   @default(false)
  source      String?
  optedInAt   DateTime?
  optedOutAt  DateTime?
  unsubToken  String    @unique @default(cuid())
  /// Vendég checkout welcome 10% – e-mailhez kötve, hogy ne lehessen újra.
  hasRedeemedWelcomeCoupon Boolean @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([optedIn, confirmed])
}

/// Bejelentkezett felhasználó kosár pillanatképe (elhagyott kosár adminhoz).
model UserCartSnapshot {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           Json
  itemCount       Int      @default(0)
  subtotalHuf     Int      @default(0)
  lastUpdatedAt   DateTime @updatedAt
  createdAt       DateTime @default(now())
  lastOfferAt     DateTime?
  lastOfferPercent Int?
  lastOfferCouponId String?
  @@index([lastUpdatedAt])
  @@index([itemCount])
}

/// Macska (5%) és regisztrációs (10%) egyszeri kupon – szerver oldali napló (admin láthatóság).
model UserPromoCoupon {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// cat | registration
  kind      String
  /// claimed | used
  status    String   @default("claimed")
  claimedAt DateTime @default(now())
  usedAt    DateTime?
  @@unique([userId, kind])
  @@index([kind, status])
  @@index([claimedAt])
}

model Order {
  id                 String   @id
  status             String
  orderGroupId       String?
  orderType          String?
  subtotalHuf        Int
  discountHuf         Int
  totalHuf           Int
  currency           String   @default("huf")
  createdAt          DateTime @default(now())
  customerEmail      String?
  customerName       String?
  customerPhone      String?
  shippingPostalCode String?
  shippingCity       String?
  shippingStreet     String?
  shippingHouseNumber String?
  billingSameAsShipping Boolean @default(true)
  billingPostalCode  String?
  billingCity        String?
  billingStreet      String?
  billingHouseNumber String?
  /// Futárnak szóló megjegyzés / cím pontosítás (kapukód, emelet, stb.).
  deliveryNotes      String?
  /// Cím típusa: home | business
  addressType        String?
  stripeSessionId    String?
  paymentIntentId    String?
  amountPaid         Int?
  currencyPaid       String?
  paidAt             DateTime?
  paidWebhookEventId String?
  countedForLoyalty  Boolean  @default(false)
  refundedAmount    Int?
  refundStatus      String?
  cancelRequestedAt DateTime?
  userId             String?
  user              User?    @relation(fields: [userId], references: [id])
  /// Ponttal fizetett összeg (Ft) – max. kosár 30%-a.
  pointsDiscountHuf Int      @default(0)
  /// Levont pontok száma (checkout mentés).
  pointsUsed         Int      @default(0)
  /// Checkout DB kupon (admin / gamification kód).
  couponId           String?
  coupon             Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  /// Sikeres fizetés után usedCount növelve (rendelés-csoportonként egyszer).
  couponUsageRecorded Boolean @default(false)
  /// Manuálisan kiválasztott kuponok a checkouton: ["cat","birthday","welcome",...].
  appliedCoupons     Json?
  /// Kuponégés + pontlevonás lefuttatva (webhook / siker oldal – idempotens).
  rewardsFinalized   Boolean  @default(false)
  /// Admin címkenyomtatás időpontja (null = még nem nyomtatva).
  printedAt          DateTime?
  /// Fizetéskor rögzített szállítási cím (vásárlói módosítás előtt).
  originalShippingPostalCode String?
  originalShippingCity       String?
  originalShippingStreet     String?
  originalShippingHouseNumber String?
  originalCustomerName       String?
  originalCustomerPhone      String?
  /// Vásárló utólagos címmódosításának időpontja (null = nem módosított).
  shippingAddressChangedAt   DateTime?
  /// Biztonságos token a visszaigazoló e-mail címmódosító linkhez (bejelentkezés nélkül).
  shippingEditToken          String?  @unique
  items             OrderItem[]
  paymentTransactions PaymentTransaction[]

  @@index([status, createdAt])
  @@index([orderGroupId])
  @@index([userId, createdAt])
  @@index([stripeSessionId])
  @@index([paymentIntentId])
  @@index([printedAt])
  @@index([shippingAddressChangedAt])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  qty             Int
  fulfillmentType String
  priceHuf        Int
  name            String?
  /// Fizetéskori SKU pillanatkép (a termék sku mezőjéből).
  sku             String?  @db.VarChar(50)
  /// Egyedi gyártási paraméterek (szín, anyag, stb.) a 3D farm / AI számára.
  parameters      Json?

  @@index([productId])
  @@index([orderId])
  @@index([sku])
}

model PaymentTransaction {
  id          String   @id
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  mode        String
  status      String
  amount      Int
  currency    String
  /// Provider-oldali referencia (pl. Stripe PaymentIntent id) – unique a dupla webhook ellen.
  providerRef String?  @unique
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([orderId, status])
  @@index([status, createdAt])
}

model ProductLike {
  id        String   @id @default(cuid())
  productId String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Gamification: napi 10 lájk számlálóhoz – unlike esetén false, sor megmarad auditra
  countsForDailyBonus Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([productId, userId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model LoyaltyRecord {
  id                     String   @id @default(cuid())
  userId                 String?
  user                   User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                  String   @unique
  qualifyingPaidOrdersCount Int   @default(0)
  loyaltyPercent         Int     @default(0)
  lastUpdatedAt          DateTime @updatedAt
}

/// Singleton admin fiók (közös ADMIN_API_KEY) – Google Authenticator TOTP 2FA.
model Admin {
  id                     String    @id @default("admin")
  totpSecret             String?
  /// Újrapárosítás: az új secret addig itt van, amíg a verify-setup meg nem erősíti.
  pendingTotpSecret      String?
  isTwoFactorEnabled     Boolean   @default(false)
  /// Következő belépéshez új ADMIN_API_KEY kell (a régi fingerprintdel a login elutasított).
  mustChangeKey          Boolean   @default(false)
  /// SHA-256 hex az aktuálisan elfogadott ADMIN_API_KEY-ről (nem a nyers kulcs).
  apiKeyFingerprint      String?
  keyConfirmedAt         DateTime?
  /// Bcrypt hash – opcionális kiegészítő (legacy) admin jelszó. A nyers ADMIN_API_KEY nem kerül ide.
  passwordHash           String?
  passwordSetAt          DateTime?
  /// SHA-256 a nyers reset tokenről; a nyers érték csak az e-mailben van.
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  /// Jelszócsere / reset után a JWT `ep` claimnek ezzel kell egyeznie.
  sessionEpoch           Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model AdminAction {
  id            String   @id @default(cuid())
  action        String
  orderId       String?
  success       Boolean
  details       String?
  ipAddress     String?
  userAgent     String?
  actorId       String?
  actorUsername String?
  actorRole     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
}

/// Név szerinti admin operátor – RBAC (owner | support | catalog | viewer).
model AdminOperator {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

/// Tömeges törlés (és hasonló) jóváhagyási kérelmek – non-owner → PENDING_APPROVAL.
model AdminPendingApproval {
  id                   String    @id @default(cuid())
  /// pl. bulk_delete_products | bulk_price_products | bulk_delete_users
  type                 String
  /// PENDING_APPROVAL | APPROVED | REJECTED | EXPIRED
  status               String
  /// { kind, resource, ids[, mode, priceHuf, percentChange] }
  payload              Json
  requestedById        String?
  requestedByUsername  String?
  requestedByRole      String?
  reviewedById         String?
  reviewedByUsername   String?
  expiresAt            DateTime
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status, expiresAt])
  @@index([createdAt])
}

/// Logout után a JWT jti denylistája a lejáratig.
model AdminRevokedSession {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Ismert admin belépési eszköz. Kulcs: SHA-256 hash (nyers UA/hints nem tárolódik azonosítóként).
model AdminLoginDevice {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  /// Rövid megjelenítés a beállításokban (nem a hash bemenete).
  userAgent   String?
  lastCountry String?
  lastIp      String?
  loginCount  Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now()) @updatedAt

  @@index([lastSeenAt])
}

/// Látott admin belépési országkódok (CDN geo header). Új ország → riasztás.
model AdminLoginCountry {
  countryCode String   @id
  loginCount  Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now()) @updatedAt
}

/// Sourcing slot foglalás: atomi maxOrders védelem. RESERVED = checkout indítva, 15 min; PAID = fizetve; EXPIRED/CANCELED = felszabadult.
model ProductReservation {
  id        String   @id @default(cuid())
  productId String
  orderId   String?
  status    String   // RESERVED | PAID | EXPIRED | CANCELED
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([productId, status, expiresAt])
}

/// AI telefon hívás összefoglaló (voice agent webhook).
model Call {
  id            String   @id @default(cuid())
  callId        String   @unique
  timestamp     DateTime
  language      String   // hu | en
  mode          String   // b2c | b2b
  callerNumber  String?
  consent       Boolean  @default(false)
  summary       String?
  transcript    String?  // csak consent=true esetén mentjük
  tags          String[] @default([]) // shipping, partner, callback_required, stb.
  endReason     String?  // silence_timeout | non_responsive | max_duration_guard | normal | stb.
  durationSec   Int?
  lastPromptKey String?
  createdAt     DateTime @default(now())
  @@index([timestamp])
  @@index([callId])
}

/// Visszahívás kérés a webes "Kérj visszahívást" űrlapból.
model CallbackRequest {
  id             String   @id @default(cuid())
  name           String
  phone          String
  topic          String?
  preferredTime  String?
  status         String   @default("pending") // pending | done | cancelled
  note           String?  // admin megjegyzés, max 200 char
  emailSent      Boolean?
  webhookSent    Boolean?
  deliveryStatus String?  // ok | partial | failed
  createdAt      DateTime @default(now())
  @@index([status])
  @@index([createdAt])
}

/// Napi adatmegőrzési job napló (törölt sorok száma, success/fail).
model DataRetentionLog {
  id                    String   @id @default(cuid())
  runAt                 DateTime @default(now())
  deletedCallbacks      Int      @default(0)
  deletedCallSummaries  Int      @default(0)
  deletedTranscripts   Int      @default(0)
  success               Boolean
  details               String?
}

/// Voice/API hívás napló (rate limit, consent=false események, audit).
model VoiceApiLog {
  id         String   @id @default(cuid())
  endpoint   String
  callId     String?
  consent   Boolean?
  success   Boolean
  details   String?
  createdAt  DateTime @default(now())
  @@index([createdAt])
}

/// AI chat kérdések naplója – anonim (IP hash), admin statisztikához.
model ChatLog {
  id           String   @id @default(cuid())
  question     String
  /// Normalizált szöveg csoportosításhoz (kisbetű, trim, whitespace).
  questionNorm String
  /// SHA-256 hash – nyers IP nem tárolódik.
  ipHash       String
  locale       String   @default("hu")
  createdAt    DateTime @default(now())
  @@index([questionNorm])
  @@index([createdAt])
}

// ─── Gamification (pontrendszer) ───────────────────────────────────────────

/// Gyors olvasás: cache-elt egyenleg. Forrás igazság: PointTransaction (append-only).
model UserPointWallet {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance              Int      @default(0)
  lifetimeEarned       Int      @default(0)
  lifetimeRedeemed     Int      @default(0)
  gamificationSuspended Boolean @default(false)
  suspendedAt          DateTime?
  suspendReason        String?
  lastReconciledAt     DateTime?
  /// Optimistic lock – párhuzamos pontírás ellen
  version              Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// Append-only pont főkönyv – UPDATE/DELETE tiltva az app rétegben.
model PointTransaction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Pozitív = jóváírás, negatív = levonás. Soha 0.
  delta           Int
  balanceAfter    Int
  type            String   // BROWSE_5MIN | LIKE_DAILY_BONUS | REDEEM_COUPON | REVERSAL | ADMIN_ADJUST
  reason          String?
  idempotencyKey  String   @unique
  referenceType   String?  // browse_day | product_like | coupon | order
  referenceId     String?
  metadata        Json?
  createdAt       DateTime @default(now())
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
}

/// Outbox: API gyors válasz → háttérben feldolgozás (nem terheli a fő requestet).
model PointEvent {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String   // BROWSE_5MIN | LIKE_DAILY_BONUS | REDEEM_COUPON
  idempotencyKey  String   @unique
  payload         Json     @default("{}")
  status          String   @default("pending") // pending | processing | completed | failed
  attempts        Int      @default(0)
  maxAttempts     Int      @default(5)
  lastError       String?
  scheduledAt     DateTime @default(now())
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  @@index([status, scheduledAt])
  @@index([userId, createdAt])
}

/// Napi összesítő snapshot – gyors dashboard / reconciliation (opcionális cache).
model PointSnapshot {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  balance   Int
  txCount   Int      @default(0)
  createdAt DateTime @default(now())
  @@unique([userId, date])
  @@index([date])
}

/// Napi 5 perc aktív böngészés – Europe/Budapest naptári nap.
model UserDailyActivity {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityDate           DateTime  @db.Date
  activeSeconds          Int       @default(0)
  /// Aktuális 5 perces session haladása (bónusz után nullázódik).
  sessionProgressSeconds Int       @default(0)
  /// Ma hány böngészés bónusz járt (max 2 / nap).
  bonusGrantedCount      Int       @default(0)
  lastBonusGrantedAt     DateTime?
  lastHeartbeatAt        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  @@unique([userId, activityDate])
  @@index([activityDate])
}

/// 12 órás gördülő ablak: max 10 pontszerző lájk / ablak.
model UserLikePointWindow {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  windowStartedAt     DateTime
  qualifyingLikeCount Int      @default(0)
  bonusGranted        Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Heti Szerencsekerék – 10 kedvelt termék, 3 napig érvényes, tier kedvezmény (15/20/25%).
model LuckySpin {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ISO hét azonosító (Europe/Budapest), pl. "2026-W28"
  weekId      String
  /// Kiválasztott 10 termék ID (ProductLike alapján)
  productIds  String[]
  /// Pörgetéskor zárolt árak: { productId: priceHuf }
  priceSnapshot Json     @default("{}")
  generatedAt DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  @@unique([userId, weekId])
  @@index([userId, expiresAt])
}
