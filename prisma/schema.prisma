// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Webshop termékek – adminból kezelhetők. Sourcing deal időzítés itt tárolódik (deploy után nem resetelődik).
model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  nameEn           String?
  nameDe           String?
  nameRo           String?
  description_hu    String   @default("")
  description_en   String   @default("")
  description_de   String   @default("")
  description_ro   String   @default("")
  condition        String   @default("Új")
  category         String
  image            String
  images           String[] @default([])
  images360        String[] @default([])
  /// Színenkénti galéria: ColorVariant[] vagy legacy { [colorId]: string[] }.
  colorImages      Json?
  modelUrl         String?
  priceHuf         Int
  priceEur         Int
  discountPriceHuf Int?
  discountPriceEur Int?
  /// Készlet: -1 = végtelen/készleten; 0 = elfogyott; >0 = darabszám.
  stock            Int      @default(-1)
  variants         Json?    // [{ size?, color? }]
  isNew            Boolean  @default(false)
  onSale           Boolean  @default(false)
  saleStartAt      DateTime?
  saleEndAt        DateTime?
  active           Boolean  @default(true)
  archived         Boolean  @default(false)
  isColorable      Boolean  @default(false)
  likesCount       Int      @default(0)
  // Sourcing / visszaszámlálós: minden időzítés DB-ben, deploy után nem változik
  type             String   @default("stock") // stock | sourcing_deal
  sourcingEnabled  Boolean  @default(false)
  dealStartAt      DateTime?
  dealEndAt        DateTime?
  previewFrom      DateTime?
  maxOrders        Int?
  sourcingStatus   String?  // optional cache: preview | sale | soldout | closed
  /// Sorrend: kisebb = előrébb (pl. beszerzésre rendelhető listán, kategórián belül).
  sortOrder        Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Kuponok / kedvezmények – adminból kezelhetők.
model Coupon {
  id           String    @id @default(cuid())
  code         String    @unique
  discountType String    // percent | fixed
  discountValue Int     // percent 0-100 or HUF
  active       Boolean   @default(true)
  validFrom    DateTime?
  validUntil   DateTime?
  minOrderHuf  Int?
  maxUses      Int?     // null = unlimited
  usedCount    Int       @default(0)
  /// Gamification: személyes kupon tulajdonos (egy user = egy aktív gamification kupon)
  userId       String?
  user         User?     @relation("GamificationCoupons", fields: [userId], references: [id], onDelete: SetNull)
  /// gamification | admin | registration
  source       String?
  /// Melyik pontlevonás hozta létre (append-only audit)
  pointTransactionId String? @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
  @@index([userId, active])
  @@index([source])
}

/// Admin / chatbot / webshop beállítások – key-value.
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON or plain string
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  passwordHash String?  // null = OAuth (pl. Google) felhasználó
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  productLikes ProductLike[]
  loyaltyRecords LoyaltyRecord[]
  pointWallet UserPointWallet?
  pointTransactions PointTransaction[]
  pointEvents PointEvent[]
  dailyActivities UserDailyActivity[]
  gamificationCoupons Coupon[] @relation("GamificationCoupons")
  promoCoupons        UserPromoCoupon[]
  cartSnapshot        UserCartSnapshot?
  likePointWindow UserLikePointWindow?
  luckySpins LuckySpin[]
}

/// Bejelentkezett felhasználó kosár pillanatképe (elhagyott kosár adminhoz).
model UserCartSnapshot {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           Json
  itemCount       Int      @default(0)
  subtotalHuf     Int      @default(0)
  lastUpdatedAt   DateTime @updatedAt
  createdAt       DateTime @default(now())
  lastOfferAt     DateTime?
  lastOfferPercent Int?
  lastOfferCouponId String?
  @@index([lastUpdatedAt])
  @@index([itemCount])
}

/// Macska (5%) és regisztrációs (10%) egyszeri kupon – szerver oldali napló (admin láthatóság).
model UserPromoCoupon {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// cat | registration
  kind      String
  /// claimed | used
  status    String   @default("claimed")
  claimedAt DateTime @default(now())
  usedAt    DateTime?
  @@unique([userId, kind])
  @@index([kind, status])
  @@index([claimedAt])
}

model Order {
  id                 String   @id
  status             String
  orderGroupId       String?
  orderType          String?
  subtotalHuf        Int
  discountHuf         Int
  totalHuf           Int
  currency           String   @default("huf")
  createdAt          DateTime @default(now())
  customerEmail      String?
  stripeSessionId    String?
  paymentIntentId    String?
  amountPaid         Int?
  currencyPaid       String?
  paidAt             DateTime?
  paidWebhookEventId String?
  countedForLoyalty  Boolean  @default(false)
  refundedAmount    Int?
  refundStatus      String?
  cancelRequestedAt DateTime?
  userId             String?
  user              User?    @relation(fields: [userId], references: [id])
  /// Ponttal fizetett összeg (Ft) – max. kosár 30%-a.
  pointsDiscountHuf Int      @default(0)
  /// Levont pontok száma (checkout mentés).
  pointsUsed         Int      @default(0)
  /// Checkout DB kupon (admin / gamification kód).
  couponId           String?
  coupon             Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  /// Sikeres fizetés után usedCount növelve (rendelés-csoportonként egyszer).
  couponUsageRecorded Boolean @default(false)
  items             OrderItem[]
  paymentTransactions PaymentTransaction[]
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  qty             Int
  fulfillmentType String
  priceHuf        Int
  name            String?
}

model PaymentTransaction {
  id         String   @id
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   String
  mode       String
  status     String
  amount     Int
  currency   String
  providerRef String?
  createdAt  DateTime @default(now())
}

model ProductLike {
  id        String   @id @default(cuid())
  productId String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Gamification: napi 10 lájk számlálóhoz – unlike esetén false, sor megmarad auditra
  countsForDailyBonus Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([productId, userId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model LoyaltyRecord {
  id                     String   @id @default(cuid())
  userId                 String?
  user                   User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                  String   @unique
  qualifyingPaidOrdersCount Int   @default(0)
  loyaltyPercent         Int     @default(0)
  lastUpdatedAt          DateTime @updatedAt
}

model AdminAction {
  id         String   @id @default(cuid())
  action     String
  orderId    String?
  success    Boolean
  details    String?
  createdAt  DateTime @default(now())
}

/// Sourcing slot foglalás: atomi maxOrders védelem. RESERVED = checkout indítva, 15 min; PAID = fizetve; EXPIRED/CANCELED = felszabadult.
model ProductReservation {
  id        String   @id @default(cuid())
  productId String
  orderId   String?
  status    String   // RESERVED | PAID | EXPIRED | CANCELED
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([productId, status, expiresAt])
}

/// AI telefon hívás összefoglaló (voice agent webhook).
model Call {
  id            String   @id @default(cuid())
  callId        String   @unique
  timestamp     DateTime
  language      String   // hu | en
  mode          String   // b2c | b2b
  callerNumber  String?
  consent       Boolean  @default(false)
  summary       String?
  transcript    String?  // csak consent=true esetén mentjük
  tags          String[] @default([]) // shipping, partner, callback_required, stb.
  endReason     String?  // silence_timeout | non_responsive | max_duration_guard | normal | stb.
  durationSec   Int?
  lastPromptKey String?
  createdAt     DateTime @default(now())
  @@index([timestamp])
  @@index([callId])
}

/// Visszahívás kérés a webes "Kérj visszahívást" űrlapból.
model CallbackRequest {
  id             String   @id @default(cuid())
  name           String
  phone          String
  topic          String?
  preferredTime  String?
  status         String   @default("pending") // pending | done | cancelled
  note           String?  // admin megjegyzés, max 200 char
  emailSent      Boolean?
  webhookSent    Boolean?
  deliveryStatus String?  // ok | partial | failed
  createdAt      DateTime @default(now())
  @@index([status])
  @@index([createdAt])
}

/// Napi adatmegőrzési job napló (törölt sorok száma, success/fail).
model DataRetentionLog {
  id                    String   @id @default(cuid())
  runAt                 DateTime @default(now())
  deletedCallbacks      Int      @default(0)
  deletedCallSummaries  Int      @default(0)
  deletedTranscripts   Int      @default(0)
  success               Boolean
  details               String?
}

/// Voice/API hívás napló (rate limit, consent=false események, audit).
model VoiceApiLog {
  id         String   @id @default(cuid())
  endpoint   String
  callId     String?
  consent   Boolean?
  success   Boolean
  details   String?
  createdAt  DateTime @default(now())
  @@index([createdAt])
}

/// AI chat kérdések naplója – anonim (IP hash), admin statisztikához.
model ChatLog {
  id           String   @id @default(cuid())
  question     String
  /// Normalizált szöveg csoportosításhoz (kisbetű, trim, whitespace).
  questionNorm String
  /// SHA-256 hash – nyers IP nem tárolódik.
  ipHash       String
  locale       String   @default("hu")
  createdAt    DateTime @default(now())
  @@index([questionNorm])
  @@index([createdAt])
}

// ─── Gamification (pontrendszer) ───────────────────────────────────────────

/// Gyors olvasás: cache-elt egyenleg. Forrás igazság: PointTransaction (append-only).
model UserPointWallet {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance              Int      @default(0)
  lifetimeEarned       Int      @default(0)
  lifetimeRedeemed     Int      @default(0)
  gamificationSuspended Boolean @default(false)
  suspendedAt          DateTime?
  suspendReason        String?
  lastReconciledAt     DateTime?
  /// Optimistic lock – párhuzamos pontírás ellen
  version              Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// Append-only pont főkönyv – UPDATE/DELETE tiltva az app rétegben.
model PointTransaction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Pozitív = jóváírás, negatív = levonás. Soha 0.
  delta           Int
  balanceAfter    Int
  type            String   // BROWSE_5MIN | LIKE_DAILY_BONUS | REDEEM_COUPON | REVERSAL | ADMIN_ADJUST
  reason          String?
  idempotencyKey  String   @unique
  referenceType   String?  // browse_day | product_like | coupon | order
  referenceId     String?
  metadata        Json?
  createdAt       DateTime @default(now())
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([referenceType, referenceId])
}

/// Outbox: API gyors válasz → háttérben feldolgozás (nem terheli a fő requestet).
model PointEvent {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String   // BROWSE_5MIN | LIKE_DAILY_BONUS | REDEEM_COUPON
  idempotencyKey  String   @unique
  payload         Json     @default("{}")
  status          String   @default("pending") // pending | processing | completed | failed
  attempts        Int      @default(0)
  maxAttempts     Int      @default(5)
  lastError       String?
  scheduledAt     DateTime @default(now())
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  @@index([status, scheduledAt])
  @@index([userId, createdAt])
}

/// Napi összesítő snapshot – gyors dashboard / reconciliation (opcionális cache).
model PointSnapshot {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  balance   Int
  txCount   Int      @default(0)
  createdAt DateTime @default(now())
  @@unique([userId, date])
  @@index([date])
}

/// Napi 5 perc aktív böngészés – Europe/Budapest naptári nap.
model UserDailyActivity {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityDate           DateTime  @db.Date
  activeSeconds          Int       @default(0)
  /// Aktuális 5 perces session haladása (bónusz után nullázódik).
  sessionProgressSeconds Int       @default(0)
  /// Ma hány böngészés bónusz járt (max 2 / nap).
  bonusGrantedCount      Int       @default(0)
  lastBonusGrantedAt     DateTime?
  lastHeartbeatAt        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  @@unique([userId, activityDate])
  @@index([activityDate])
}

/// 12 órás gördülő ablak: max 10 pontszerző lájk / ablak.
model UserLikePointWindow {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  windowStartedAt     DateTime
  qualifyingLikeCount Int      @default(0)
  bonusGranted        Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Heti Szerencsekerék – 10 kedvelt termék, 3 napig érvényes, tier kedvezmény (15/20/25%).
model LuckySpin {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ISO hét azonosító (Europe/Budapest), pl. "2026-W28"
  weekId      String
  /// Kiválasztott 10 termék ID (ProductLike alapján)
  productIds  String[]
  /// Pörgetéskor zárolt árak: { productId: priceHuf }
  priceSnapshot Json     @default("{}")
  generatedAt DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  @@unique([userId, weekId])
  @@index([userId, expiresAt])
}
